{
  "name": "go_flashcards",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@zxing/text-encoding": "^0.9.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:web": "node --import tsx --test --test-timeout=300000 \"tests/web/*.web.ts\"",
    "assets:icons": "tsx scripts/make-icons.ts",
    "check:store": "tsx scripts/check-store.ts",
    "assets:screenshots": "tsx scripts/make-screenshots.ts",
    "privacy:sync": "tsx scripts/sync-privacy.ts",
    "test:native": "node --import tsx --test --test-timeout=600000 \"tests/native/*.native.ts\"",
    "licenses": "tsx scripts/licenses.ts",
    "release": "tsx scripts/release.ts"
  },
  "private": true,
  "description": "Go (baduk/weiqi) flashcards: tsumego and joseki training from SGF, for iOS, Android and web.",
  "license": "SEE LICENSE IN LICENSE"
}
